# ─────────────────────────────────────────────────────────
# SkillBridge — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
# Supabase PostgreSQL connection string (Transaction Pooler for API)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Direct connection (used by Prisma Migrate - bypasses PgBouncer)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Supabase ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── AI (Gemini) ───────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Override the model without changing code:
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=2048

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@skillbridge.app

# ── App ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Origin of the frontend (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# ── Added in Phase 10 — Redis (optional) ──────────────────
# REDIS_URL=rediss://default:...@...upstash.io:6379

# ── Added in Phase 12 — Production ───────────────────────
# RAILWAY_STATIC_URL=https://api.skillbridge.app
